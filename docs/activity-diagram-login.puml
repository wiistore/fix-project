@startuml Activity Diagram - Login

title Activity Diagram: Proses Login

start

:User membuka halaman Login;

:User memasukkan Username dan Password;

:Klik tombol Login;

if (Input kosong?) then (ya)
    :Tampilkan pesan error\n"Username dan password wajib diisi";
    stop
else (tidak)
endif

:Sistem mencari user berdasarkan username/email;

if (User ditemukan?) then (tidak)
    :Tampilkan pesan error\n"Username atau password salah";
    stop
else (ya)
endif

:Sistem memverifikasi password;

if (Password cocok?) then (tidak)
    :Tampilkan pesan error\n"Username atau password salah";
    stop
else (ya)
endif

if (Status user aktif?) then (tidak)
    :Tampilkan pesan error\n"Akun sedang nonaktif";
    stop
else (ya)
endif

if (Role valid?) then (tidak)
    :Tampilkan pesan error\n"Role tidak valid";
    stop
else (ya)
endif

:Simpan session login;
:Regenerate session ID;

if (Role?) then (admin)
    :Redirect ke /admin/dashboard;
else (kasir)
    :Redirect ke /kasir/dashboard;
endif

stop

@enduml
