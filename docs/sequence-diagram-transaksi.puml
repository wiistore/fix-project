@startuml Sequence Diagram - Transaksi Penjualan

title Sequence Diagram: Proses Transaksi Penjualan (POS)

actor "Admin/Kasir" as user
participant "Browser\n(POS Interface)" as browser
participant "Router" as router
participant "TransaksiController" as ctrl
participant "Transaksi Model" as trxModel
participant "DetailTransaksi Model" as detModel
participant "Barang Model" as brgModel
participant "Restock Model" as rstModel
participant "Session" as session
database "Database" as db

== Halaman POS ==
user -> browser : Buka halaman transaksi
browser -> router : GET /kasir/transaksi
router -> ctrl : kasirIndex()
ctrl -> ctrl : requireRole('kasir')
ctrl -> brgModel : getActive()
brgModel -> db : SELECT barang aktif
db --> brgModel : list barang
ctrl --> browser : Render halaman POS + daftar barang

== Proses Checkout ==
user -> browser : Scan/pilih barang, atur qty
user -> browser : Pilih metode bayar, input nominal
user -> browser : Klik "Bayar"

browser -> router : POST /transaksi/store
router -> ctrl : store()
ctrl -> ctrl : requireRole(['admin','kasir'])
ctrl -> ctrl : normalizeCart(cart_json)
ctrl -> ctrl : validateTransactionInput()

alt Validasi gagal
    ctrl -> session : setFlash('error', '...')
    ctrl --> browser : Redirect kembali
else Validasi berhasil
    ctrl -> db : beginTransaction()

    ctrl -> ctrl : prepareItems(items)
    loop Setiap item di keranjang
        ctrl -> brgModel : findActiveById(id)
        brgModel -> db : SELECT barang
        db --> brgModel : data barang
        ctrl -> rstModel : getLastHargaBeli(id)
        rstModel -> db : SELECT harga_beli terakhir
        db --> rstModel : harga_beli
        ctrl -> ctrl : Hitung subtotal, laba
    end

    ctrl -> trxModel : generateCode()
    trxModel --> ctrl : "TRX202605..."
    ctrl -> trxModel : create(data transaksi)
    trxModel -> db : INSERT INTO transaksi
    db --> trxModel : transaksi_id

    loop Setiap item
        ctrl -> detModel : create(detail item)
        detModel -> db : INSERT INTO detail_transaksi
        ctrl -> brgModel : decreaseStock(id, qty)
        brgModel -> db : UPDATE stok = stok - qty
    end

    ctrl -> db : commit()
    ctrl -> session : setFlash('success', '...')
    ctrl --> browser : Redirect ke struk
end

== Tampilkan Struk ==
browser -> router : GET /kasir/transaksi/struk/{id}
router -> ctrl : kasirStruk(id)
ctrl -> trxModel : findById(id)
ctrl -> detModel : getItemsWithBarang(id)
ctrl --> browser : Render halaman struk

@enduml
