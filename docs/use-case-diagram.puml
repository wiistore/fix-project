@startuml Use Case Diagram - Kopsis POS

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Use Case Diagram\nSistem POS Koperasi Siswa (Kopsis)

actor "Admin" as admin
actor "Kasir" as kasir

rectangle "Sistem POS Kopsis" {

    ' === AUTH ===
    package "Autentikasi" {
        usecase "Login" as UC_LOGIN
        usecase "Logout" as UC_LOGOUT
        usecase "Validasi Credential" as UC_VALIDASI_CRED
        usecase "Cek Status Akun" as UC_CEK_STATUS
    }

    ' === DASHBOARD ===
    package "Manajemen Dashboard" {
        usecase "Lihat Dashboard Admin" as UC_DASH_ADMIN
        usecase "Lihat Dashboard Kasir" as UC_DASH_KASIR
    }

    ' === BARANG ===
    package "Manajemen Barang" {
        usecase "Kelola Barang" as UC_BARANG_KELOLA
        usecase "Tambah Barang" as UC_BARANG_ADD
        usecase "Edit Barang" as UC_BARANG_EDIT
        usecase "Hapus/Nonaktifkan Barang" as UC_BARANG_DEL
        usecase "Toggle Status Barang" as UC_BARANG_TOGGLE
        usecase "Generate Barcode" as UC_BARANG_BARCODE
        usecase "Cetak Label Barang" as UC_BARANG_LABEL
        usecase "Validasi Kode/Barcode Unik" as UC_BARANG_VALIDASI
    }

    ' === KATEGORI ===
    package "Manajemen Kategori" {
        usecase "Kelola Kategori" as UC_KAT_KELOLA
        usecase "Tambah Kategori" as UC_KAT_ADD
        usecase "Edit Kategori" as UC_KAT_EDIT
        usecase "Hapus Kategori" as UC_KAT_DEL
        usecase "Cek Relasi Barang" as UC_KAT_CEK_RELASI
    }

    ' === SUPPLIER ===
    package "Manajemen Supplier" {
        usecase "Kelola Supplier" as UC_SUP_KELOLA
        usecase "Tambah Supplier" as UC_SUP_ADD
        usecase "Edit Supplier" as UC_SUP_EDIT
        usecase "Hapus/Nonaktifkan Supplier" as UC_SUP_DEL
        usecase "Toggle Status Supplier" as UC_SUP_TOGGLE
    }

    ' === RESTOCK ===
    package "Manajemen Restock" {
        usecase "Kelola Restock" as UC_RESTOCK_KELOLA
        usecase "Tambah Stok Masuk" as UC_RESTOCK_IN
        usecase "Kurangi Stok (Keluar)" as UC_RESTOCK_OUT
        usecase "Update Harga Jual" as UC_RESTOCK_HARGA
        usecase "Validasi Stok Cukup" as UC_RESTOCK_CEK_STOK
    }

    ' === USER ===
    package "Manajemen User Kasir" {
        usecase "Kelola User" as UC_USER_KELOLA
        usecase "Tambah Kasir" as UC_USER_ADD
        usecase "Edit Kasir" as UC_USER_EDIT
        usecase "Reset Password Kasir" as UC_USER_RESET
        usecase "Hapus/Nonaktifkan Kasir" as UC_USER_DEL
        usecase "Toggle Status Kasir" as UC_USER_TOGGLE
        usecase "Validasi Username/Email Unik" as UC_USER_VALIDASI
    }

    ' === TRANSAKSI ===
    package "Transaksi Penjualan" {
        usecase "Buat Transaksi" as UC_TRX_CREATE
        usecase "Lihat Struk" as UC_TRX_STRUK
        usecase "Download PDF Struk" as UC_TRX_PDF
        usecase "Validasi Keranjang" as UC_TRX_VALIDASI
        usecase "Kurangi Stok Barang" as UC_TRX_KURANGI_STOK
        usecase "Hitung Total & Laba" as UC_TRX_HITUNG
    }

    ' === RIWAYAT ===
    package "Riwayat Transaksi" {
        usecase "Kelola Riwayat Transaksi" as UC_RIW_KELOLA
        usecase "Lihat Detail Transaksi" as UC_RIW_DETAIL
        usecase "Edit Transaksi" as UC_RIW_EDIT
        usecase "Batalkan Transaksi" as UC_RIW_CANCEL
        usecase "Kembalikan Stok" as UC_RIW_RETURN_STOK
    }

    ' === LAPORAN ===
    package "Laporan" {
        usecase "Lihat Laporan" as UC_LAP_INDEX
        usecase "Laporan Penjualan" as UC_LAP_JUAL
        usecase "Laporan Laba" as UC_LAP_LABA
        usecase "Laporan Barang Terlaris" as UC_LAP_TOP
        usecase "Laporan Restock" as UC_LAP_RESTOCK
        usecase "Export Laporan (CSV)" as UC_LAP_EXPORT
    }

    ' === PROFIL ===
    package "Profil Kasir" {
        usecase "Lihat Profil" as UC_PROFIL_VIEW
        usecase "Reset Password Sendiri" as UC_PROFIL_PW
        usecase "Verifikasi Password Lama" as UC_PROFIL_VERIF
    }
}

' ===================================================================
' INCLUDE RELATIONSHIPS (wajib terjadi, bagian dari proses utama)
' ===================================================================

' Auth
UC_LOGIN ..> UC_VALIDASI_CRED : <<include>>
UC_LOGIN ..> UC_CEK_STATUS : <<include>>

' Barang
UC_BARANG_ADD ..> UC_BARANG_VALIDASI : <<include>>
UC_BARANG_EDIT ..> UC_BARANG_VALIDASI : <<include>>

' Kategori
UC_KAT_DEL ..> UC_KAT_CEK_RELASI : <<include>>

' User
UC_USER_ADD ..> UC_USER_VALIDASI : <<include>>
UC_USER_EDIT ..> UC_USER_VALIDASI : <<include>>

' Transaksi
UC_TRX_CREATE ..> UC_TRX_VALIDASI : <<include>>
UC_TRX_CREATE ..> UC_TRX_HITUNG : <<include>>
UC_TRX_CREATE ..> UC_TRX_KURANGI_STOK : <<include>>

' Restock keluar
UC_RESTOCK_OUT ..> UC_RESTOCK_CEK_STOK : <<include>>

' Riwayat - batalkan
UC_RIW_CANCEL ..> UC_RIW_RETURN_STOK : <<include>>

' Profil kasir
UC_PROFIL_PW ..> UC_PROFIL_VERIF : <<include>>

' ===================================================================
' EXTEND RELATIONSHIPS (opsional, terjadi hanya dalam kondisi tertentu)
' ===================================================================

' Setelah transaksi berhasil, bisa lihat/download struk
UC_TRX_CREATE <.. UC_TRX_STRUK : <<extend>>
UC_TRX_STRUK <.. UC_TRX_PDF : <<extend>>

' Restock masuk bisa opsional update harga jual
UC_RESTOCK_IN <.. UC_RESTOCK_HARGA : <<extend>>

' Laporan bisa opsional di-export
UC_LAP_JUAL <.. UC_LAP_EXPORT : <<extend>>
UC_LAP_LABA <.. UC_LAP_EXPORT : <<extend>>
UC_LAP_TOP <.. UC_LAP_EXPORT : <<extend>>
UC_LAP_RESTOCK <.. UC_LAP_EXPORT : <<extend>>

' Kelola barang extend: cetak label, generate barcode (opsional)
UC_BARANG_KELOLA <.. UC_BARANG_LABEL : <<extend>>
UC_BARANG_KELOLA <.. UC_BARANG_BARCODE : <<extend>>

' Edit transaksi extend dari riwayat (opsional, jika status masih selesai)
UC_RIW_KELOLA <.. UC_RIW_EDIT : <<extend>>
UC_RIW_KELOLA <.. UC_RIW_CANCEL : <<extend>>

' ===================================================================
' ACTOR → USE CASE RELATIONS
' ===================================================================

' === ADMIN ===
admin --> UC_LOGIN
admin --> UC_LOGOUT
admin --> UC_DASH_ADMIN
admin --> UC_BARANG_KELOLA
admin --> UC_BARANG_ADD
admin --> UC_BARANG_EDIT
admin --> UC_BARANG_DEL
admin --> UC_BARANG_TOGGLE
admin --> UC_KAT_KELOLA
admin --> UC_KAT_ADD
admin --> UC_KAT_EDIT
admin --> UC_KAT_DEL
admin --> UC_SUP_KELOLA
admin --> UC_SUP_ADD
admin --> UC_SUP_EDIT
admin --> UC_SUP_DEL
admin --> UC_SUP_TOGGLE
admin --> UC_RESTOCK_KELOLA
admin --> UC_RESTOCK_IN
admin --> UC_RESTOCK_OUT
admin --> UC_USER_KELOLA
admin --> UC_USER_ADD
admin --> UC_USER_EDIT
admin --> UC_USER_RESET
admin --> UC_USER_DEL
admin --> UC_USER_TOGGLE
admin --> UC_TRX_CREATE
admin --> UC_RIW_KELOLA
admin --> UC_RIW_DETAIL
admin --> UC_LAP_INDEX
admin --> UC_LAP_JUAL
admin --> UC_LAP_LABA
admin --> UC_LAP_TOP
admin --> UC_LAP_RESTOCK

' === KASIR ===
kasir --> UC_LOGIN
kasir --> UC_LOGOUT
kasir --> UC_DASH_KASIR
kasir --> UC_TRX_CREATE
kasir --> UC_PROFIL_VIEW
kasir --> UC_PROFIL_PW

' ===================================================================
' NOTES
' ===================================================================

note right of UC_PROFIL_PW
  Kasir hanya bisa reset password.
  Username & email TIDAK bisa diedit.
  Wajib verifikasi password lama.
end note

note right of UC_RIW_CANCEL
  <<include>> Kembalikan Stok:
  Stok otomatis dikembalikan
  saat transaksi dibatalkan.
end note

note right of UC_RESTOCK_OUT
  <<include>> Validasi Stok:
  Stok harus >= qty keluar.
  Wajib input alasan.
end note

note right of UC_TRX_CREATE
  <<include>> Validasi Keranjang,
  Hitung Total & Laba,
  Kurangi Stok Barang.
  Semua dalam 1 transaction.
end note

note right of UC_RESTOCK_HARGA
  <<extend>> Opsional:
  Hanya jika admin mengisi
  harga jual baru saat restock masuk.
end note

@enduml
