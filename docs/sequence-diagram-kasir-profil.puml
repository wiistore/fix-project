@startuml Sequence Diagram - Kasir Reset Password

title Sequence Diagram: Reset Password Kasir (Halaman Profil)

actor "Kasir" as kasir
participant "Browser" as browser
participant "Router" as router
participant "KasirController" as ctrl
participant "User Model" as model
participant "Validator" as validator
participant "Security" as sec
participant "Session" as session
database "Database" as db

== Lihat Profil ==
kasir -> browser : Buka /kasir/profil
browser -> router : GET /kasir/profil
router -> ctrl : profil()
ctrl -> ctrl : requireRole('kasir')
ctrl -> session : userId()
ctrl -> model : findById(userId)
model -> db : SELECT user (tanpa password)
db --> model : data user
ctrl --> browser : Render profil\n(username & email read-only)

== Reset Password ==
kasir -> browser : Isi form\n(password lama, password baru, konfirmasi)
kasir -> browser : Klik "Simpan Password"

browser -> router : POST /kasir/profil/password
router -> ctrl : updatePassword()
ctrl -> ctrl : requireRole('kasir')

ctrl -> validator : validate(data, rules)
validator --> ctrl : errors[]

ctrl -> model : findByIdWithPassword(userId)
model -> db : SELECT ... termasuk password hash
db --> model : data + hash

ctrl -> sec : passwordVerify(current_password, hash)
sec --> ctrl : true / false

alt Password lama salah
    ctrl -> ctrl : errors['current_password'] = 'Password saat ini salah'
end

alt Ada error validasi
    ctrl -> session : set('_errors', errors)
    ctrl --> browser : Redirect /kasir/profil
else Semua valid
    ctrl -> model : updateOwnPassword(userId, new_password)
    model -> sec : passwordHash(new_password)
    sec --> model : hashed
    model -> db : UPDATE password WHERE id = ?
    db --> model : OK

    ctrl -> session : setFlash('success', 'Password berhasil diperbarui')
    ctrl --> browser : Redirect /kasir/profil
end

note over browser
  Username dan Email
  TIDAK BISA DIEDIT oleh kasir.
  Hanya bisa diedit oleh Admin
  via menu User Management.
end note

@enduml
