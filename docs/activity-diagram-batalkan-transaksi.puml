@startuml Activity Diagram - Batalkan Transaksi

title Activity Diagram: Pembatalan Transaksi (Refund)

start

:Admin membuka halaman Riwayat Transaksi;

:Admin memilih transaksi yang akan dibatalkan;

:Sistem menampilkan detail transaksi;

if (Status transaksi = "dibatalkan"?) then (ya)
    :Tampilkan error\n"Transaksi sudah dibatalkan sebelumnya";
    stop
else (tidak)
endif

:Admin input alasan pembatalan;

:Klik tombol "Batalkan Transaksi";

if (Alasan kosong?) then (ya)
    :Tampilkan error "Alasan wajib diisi";
    stop
else (tidak)
endif

:Begin Transaction;

:Ambil detail item transaksi;

partition "Loop per item" {
    :Kembalikan stok barang\n(stok + qty item);
}

:Update status transaksi = "dibatalkan";
:Simpan alasan pembatalan;

:Commit Transaction;

:Tampilkan pesan sukses\n"Transaksi berhasil dibatalkan,\nstok barang sudah dikembalikan";

:Redirect ke Riwayat Transaksi;

stop

@enduml
