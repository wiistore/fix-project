@startuml Activity Diagram - Restock

title Activity Diagram: Proses Restock (Stok Masuk / Keluar)

start

:Admin membuka halaman Restock;

:Pilih tipe: Stok Masuk atau Stok Keluar;

if (Tipe?) then (Masuk)
    :Pilih barang;
    :Pilih supplier;
    :Input qty, harga beli;
    :Input harga jual baru (opsional);
    :Input catatan (opsional);
else (Keluar)
    :Pilih barang;
    :Input qty keluar;
    :Input harga beli (referensi);
    :Input alasan (wajib);
    :Input catatan (opsional);
endif

:Klik tombol Simpan;

:Sistem validasi input;

if (Ada error validasi?) then (ya)
    :Tampilkan error pada form;
    stop
else (tidak)
endif

:Cek barang aktif di database;

if (Barang aktif?) then (tidak)
    :Tampilkan error "Barang tidak ditemukan/nonaktif";
    stop
else (ya)
endif

if (Tipe = Masuk?) then (ya)
    :Cek supplier aktif;
    if (Supplier aktif?) then (tidak)
        :Tampilkan error "Supplier nonaktif";
        stop
    else (ya)
    endif
else (tidak)
    :Cek stok mencukupi;
    if (Stok >= qty?) then (tidak)
        :Tampilkan error "Stok tidak cukup";
        stop
    else (ya)
    endif
endif

:Begin Transaction;

:Simpan record restock;

if (Tipe = Masuk?) then (ya)
    :Tambah stok barang (stok + qty);
    if (Harga jual baru diisi?) then (ya)
        :Update harga jual barang;
    else (tidak)
    endif
else (tidak)
    :Kurangi stok barang (stok - qty);
endif

:Commit Transaction;

:Tampilkan pesan sukses;
:Redirect ke daftar restock;

stop

@enduml
