@startuml Activity Diagram - Transaksi Penjualan

title Activity Diagram: Proses Transaksi Penjualan

start

:Admin/Kasir membuka halaman POS;

:Sistem menampilkan daftar barang aktif;

repeat
    :Scan barcode / pilih barang dari daftar;
    :Tentukan qty;
    :Barang masuk ke keranjang;
repeat while (Masih ada barang?) is (ya) not (tidak)

:Pilih metode pembayaran\n(Cash / QRIS / Transfer / E-Wallet);

if (Metode = Cash?) then (ya)
    :Input nominal bayar;
else (tidak)
    :Nominal = total otomatis;
endif

:Klik tombol "Bayar";

:Sistem validasi keranjang;

if (Keranjang kosong?) then (ya)
    :Tampilkan error "Keranjang masih kosong";
    stop
else (tidak)
endif

if (Metode bayar valid?) then (tidak)
    :Tampilkan error "Metode tidak valid";
    stop
else (ya)
endif

:Begin Transaction (DB);

:Hitung ulang harga dari database;

partition "Loop per item" {
    :Cek barang aktif di database;
    if (Barang ada & aktif?) then (tidak)
        :Rollback Transaction;
        :Tampilkan error;
        stop
    else (ya)
    endif

    if (Stok cukup?) then (tidak)
        :Rollback Transaction;
        :Tampilkan error "Stok tidak cukup";
        stop
    else (ya)
    endif

    :Ambil harga beli terakhir dari restock;
    :Hitung subtotal & laba per item;
}

if (Cash & nominal < total?) then (ya)
    :Rollback Transaction;
    :Tampilkan error "Nominal kurang";
    stop
else (tidak)
endif

:Generate kode transaksi unik;
:Simpan data transaksi utama;
:Simpan detail transaksi per item;
:Kurangi stok barang;

:Commit Transaction;

:Tampilkan struk transaksi;

stop

@enduml
